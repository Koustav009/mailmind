# --- IMAP ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_ARCHIVE_FOLDER=Archive
IMAP_TRASH_FOLDER=Trash
# Only fetch unread mail from the last N days (protects against huge unread history)
IMAP_LOOKBACK_DAYS=2

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_CHAT_IDS=123456789

# --- LLM router (comma-separated, ordered failover priority) ---
# Supported names: groq, openai, openrouter, together, fireworks, anthropic, custom
LLM_PROVIDERS=groq,openrouter,custom
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
LLM_STRATEGY=priority
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_STRONG=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_STRONG=

# Any OpenAI-compatible gateway (e.g. LiteLLM, vLLM, Gemini-compat endpoints)
CUSTOM_API_KEY=
CUSTOM_MODEL=gpt-4o-mini
CUSTOM_MODEL_STRONG=
CUSTOM_BASE_URL=https://your-gateway.example.com/v1

# Optional providers (enable via LLM_PROVIDERS):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_STRONG=

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_MODEL_STRONG=

FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
FIREWORKS_MODEL_STRONG=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_MODEL_STRONG=

# --- Runtime ---
# In Docker point this at the data volume, e.g.
# sqlite+aiosqlite:////app/data/agent.db
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
POLL_INTERVAL_MINUTES=5
MAX_BODY_CHARS=6000
FAILURES_BEFORE_ALERT=3

# Sender rules: comma-separated exact emails or @domain suffixes
SENDER_WHITELIST=
SENDER_BLACKLIST=

# DEBUG / INFO
LOG_LEVEL=DEBUG
